{
  "name": "linuxio-dev-status",
  "displayName": "LinuxIO dev status",
  "description": "Status bar indicator for the LinuxIO Vite dev server (make dev).",
  "version": "1.1.0",
  "publisher": "linuxio",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "linuxioDevStatus.start",
        "key": "ctrl+shift+1",
        "when": "linuxioDevStatus.active"
      },
      {
        "command": "linuxioDevStatus.stop",
        "key": "ctrl+shift+2",
        "when": "linuxioDevStatus.active"
      },
      {
        "command": "linuxioDevStatus.reinstall",
        "key": "ctrl+shift+3",
        "when": "linuxioDevStatus.active"
      }
    ],
    "commands": [
      {
        "command": "linuxioDevStatus.start",
        "title": "LinuxIO: Start dev server"
      },
      {
        "command": "linuxioDevStatus.stop",
        "title": "LinuxIO: Stop dev server"
      },
      {
        "command": "linuxioDevStatus.logs",
        "title": "LinuxIO: Show dev server logs"
      },
      {
        "command": "linuxioDevStatus.reinstall",
        "title": "LinuxIO: Reinstall (asks for the sudo password)"
      }
    ]
  }
}
