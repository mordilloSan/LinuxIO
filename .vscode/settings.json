{
  "oxc.configPath": "frontend/config/.oxlintrc.json",
  "oxc.fmt.configPath": "frontend/config/.oxfmtrc.json",
  "oxc.tsConfigPath": "frontend/tsconfig.json",
  "oxc.path.tsgolint": "frontend/node_modules/.bin/tsgolint",
  "oxc.typeAware": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  }
}
