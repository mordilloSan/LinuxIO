{
  "permissions": {
    "deny": [
      "Edit(frontend/src/api/generated/**)",
      "Edit(frontend/src/routeTree.gen.ts)",
      "Bash(go test:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(tsc:*)",
      "Bash(vitest:*)",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-pointer.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-pointer.sh"
          }
        ]
      }
    ]
  }
}
