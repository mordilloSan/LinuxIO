{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "react"],
  // ESLint plugins with no native oxc port yet, run via oxlint's JS-plugin
  // workers. Their startup (~1.7s) overlaps with tsgolint type-checking, so
  // they are free in wall-clock terms when linting with --type-aware.
  "jsPlugins": [
    { "name": "@tanstack/query", "specifier": "@tanstack/eslint-plugin-query" },
    "eslint-plugin-react-you-might-not-need-an-effect",
    // "import-x" is a reserved native alias, hence the -js suffix.
    { "name": "import-x-js", "specifier": "eslint-plugin-import-x" }
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // --- core ---
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-shadow": "off",
    "no-underscore-dangle": "off",

    // --- typescript ---
    "typescript/no-empty-interface": "warn",
    "typescript/no-deprecated": "warn",
    "typescript/consistent-type-imports": [
      "warn",
      { "disallowTypeAnnotations": false }
    ],
    "typescript/consistent-type-exports": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/unbound-method": "warn",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "typescript/no-unnecessary-template-expression": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/no-meaningless-void-operator": "warn",

    // --- react ---
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-compiler": "warn",
    "react/no-unescaped-entities": "warn",
    "react/react-in-jsx-scope": "off",
    "react/no-children-prop": "off",
    "react/no-unstable-nested-components": "off",

    // --- @tanstack/query (mirrors flat/recommended) ---
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/query/no-rest-destructuring": "warn",
    "@tanstack/query/no-unstable-deps": "error",
    "@tanstack/query/infinite-query-property-order": "error",
    "@tanstack/query/no-void-query-fn": "error",
    "@tanstack/query/mutation-property-order": "error",

    // --- react-you-might-not-need-an-effect (strict, minus no-event-handler) ---
    "react-you-might-not-need-an-effect/no-derived-state": "error",
    "react-you-might-not-need-an-effect/no-chain-state-updates": "error",
    "react-you-might-not-need-an-effect/no-adjust-state-on-prop-change": "error",
    "react-you-might-not-need-an-effect/no-reset-all-state-on-prop-change": "error",
    "react-you-might-not-need-an-effect/no-initialize-state": "error",
    "react-you-might-not-need-an-effect/no-external-store-subscription": "warn",
    "react-you-might-not-need-an-effect/no-pass-data-to-parent": "warn",
    "react-you-might-not-need-an-effect/no-pass-live-state-to-parent": "warn",

    // --- import ordering ---
    "import-x-js/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          ["parent", "sibling", "index"]
        ],
        "newlines-between": "always",
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ]
  },
  "settings": {
    "import-x/internal-regex": "^@/"
  },
  "overrides": [
    {
      // Passing a bare method to `expect(...)`/`vi.spyOn(...)` never invokes it,
      // so the unbound `this` the rule warns about cannot be observed here.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "src/test/**"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
