{
  "name": "Linux Server i/O",
  "description": "Linux server managment tool",
  "author": "MordilloSan <miguelgalizamariz@gmail.com>",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --type-aware --fix src && npm run format",
    "format": "oxfmt --no-error-on-unmatched-pattern \"src/**/*.js\" \"src/**/*.jsx\" \"src/**/*.ts\" \"src/**/*.tsx\"",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern \"src/**/*.js\" \"src/**/*.jsx\" \"src/**/*.ts\" \"src/**/*.tsx\"",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "vite build",
    "analyze": "BUNDLE_ANALYZE=true vite build",
    "bundle:metrics": "node scripts/bundle-metrics.mjs",
    "bundle:budget": "node scripts/bundle-metrics.mjs --check",
    "compiler:coverage": "node scripts/compiler-coverage.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "update": "npm update && npm outdated"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not IE 11"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ace-builds": "^1.44.0",
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-ace": "^14.0.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "smoothie": "^1.36.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "jsdom": "^29.1.1",
    "oxc-transform": "0.136.0",
    "oxfmt": "^0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.3",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
