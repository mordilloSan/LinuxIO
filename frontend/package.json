{
  "name": "Linux Server i/O",
  "description": "Linux server managment tool",
  "author": "MordilloSan <miguelgalizamariz@gmail.com>",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts --configLoader native",
    "lint": "oxlint --type-aware --fix -c config/.oxlintrc.json src config scripts/compiler-coverage.mjs scripts/run-browser-fixture.mjs && npm run format",
    "format": "oxfmt -c config/.oxfmtrc.json --no-error-on-unmatched-pattern \"src/**/*.js\" \"src/**/*.jsx\" \"src/**/*.ts\" \"src/**/*.tsx\" \"src/test/browser/**/*.html\" \"!src/routeTree.gen.ts\" \"config/**/*.ts\" \"scripts/compiler-coverage.mjs\" \"scripts/run-browser-fixture.mjs\"",
    "format:check": "oxfmt -c config/.oxfmtrc.json --check --no-error-on-unmatched-pattern \"src/**/*.js\" \"src/**/*.jsx\" \"src/**/*.ts\" \"src/**/*.tsx\" \"src/test/browser/**/*.html\" \"!src/routeTree.gen.ts\" \"config/**/*.ts\" \"scripts/compiler-coverage.mjs\" \"scripts/run-browser-fixture.mjs\"",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "vite build --config config/vite.config.ts --configLoader native",
    "analyze": "BUNDLE_ANALYZE=true vite build --config config/vite.config.ts --configLoader native",
    "bundle:metrics": "node scripts/bundle-metrics.mjs",
    "compiler:coverage": "node scripts/compiler-coverage.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:browser": "playwright test --config config/playwright.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "update": "npm update && npm outdated"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ace-builds": "^1.44.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-ace": "^15.0.0",
    "react-dom": "^19.2.8",
    "smoothie": "^1.36.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.62.1",
    "@tanstack/eslint-plugin-query": "^5.102.2",
    "@tanstack/react-query-devtools": "^5.102.2",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11",
    "web-vitals": "^6.1.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
