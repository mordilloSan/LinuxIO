# What a release is built from that no lock file pins: one KEY=value per line,
# read by the Makefile and the workflows. `make update-build-pins` moves them;
# docs/releases.md says what each one decides. Go is pinned by backend/go.mod,
# Go modules by go.sum and npm packages by frontend/package-lock.json.

# Compiles the programs and assembles the DEB: the supported system with the
# oldest C library, so the programs run on every supported system.
COMPILE_IMAGE=ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
# Assembles the RPM and the signed repositories: the current Fedora release.
RPM_IMAGE=fedora:45@sha256:a7d72ba2745b100a3351087472e5ee7b2450af7cf331e7673007e3817612839c

NODE_VERSION=26.13.1

GOLANGCI_LINT_VERSION=v2.15.0
MODERNIZE_VERSION=v0.53.0
DEADCODE_VERSION=v0.53.0
GOVULNCHECK_VERSION=v1.10.0
