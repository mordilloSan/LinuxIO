#cloud-config
# First boot of the disposable Fedora test VM (packaging/vm/linuxio-vm.sh
# create with LINUXIO_VM_DISTRO=fedora); user-data.yaml.in is Ubuntu's. The
# script fills in the @...@ values and serves this file and meta-data from
# @SEED_URL@ for the first boot only. SELinux stays enforcing.
hostname: linuxio-e2e
users:
  - name: linuxio-e2e
    shell: /bin/bash
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    hashed_passwd: '@PASSWORD_HASH@'
    ssh_authorized_keys:
      - '@SSH_KEY@'
ssh_pwauth: false
package_update: true
# Every package is brought up to date here, once, as on Ubuntu.
package_upgrade: true
packages:
  - moby-engine
  # The Compose and buildx plugins, as on Ubuntu.
  - docker-compose
  - docker-buildx
  - btrfs-progs
  # Ubuntu's image has mdadm and Fedora's does not; the btrfs suite's md
  # tests (TestBtrfsArrayMemberIntegration, the md leg of
  # TestBtrfsUnreadyIntegration) skip without it.
  - mdadm
  # The specs read LinuxIO's job records with it; Fedora 44's image does not
  # have it.
  - jq
  # What the RPM requires besides systemd, so installing it in the VM needs
  # no download (packaging/rpm/linuxio.spec).
  - pam
  - polkit
  - PackageKit
  # What assembles LinuxIO's RPM in the VM (linuxio-vm.sh install): rpmbuild,
  # the spec's systemd and SELinux macros and what they ask rpmbuild for.
  - rpm-build
  - systemd-rpm-macros
  - selinux-policy-devel
  - systemd-devel
  # What publishes it into a signed repository (linuxio-vm.sh repo-publish).
  - createrepo_c
  - rpm-sign
  - gnupg2
runcmd:
  # The metadata refresh holds dnf's lock while a suite installs a package.
  - systemctl disable --now dnf-makecache.timer
  # Fedora's packages do not start their services; Ubuntu's docker.io does.
  - systemctl enable --now docker.service
