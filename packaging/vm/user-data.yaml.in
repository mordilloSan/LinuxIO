#cloud-config
# First boot of the disposable test VM on Ubuntu or Debian
# (packaging/vm/linuxio-vm.sh create). The script fills in the @...@ values
# and serves this file and meta-data from @SEED_URL@ for the first boot only.
hostname: linuxio-e2e
users:
  - name: linuxio-e2e
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    hashed_passwd: '@PASSWORD_HASH@'
    ssh_authorized_keys:
      - '@SSH_KEY@'
ssh_pwauth: false
package_update: true
# Every package is brought up to date here, once: the timers that would do it
# later are switched off below, and no spec needs a waiting update (the ones
# about updates build their own package).
package_upgrade: true
packages:
  - docker.io
  # The Compose and buildx plugins docker.io comes without, which the docker
  # suite needs: with buildx Compose builds through Bake, as on a host that
  # has Docker's own packages.
  - '@COMPOSE_PACKAGE@'
  - docker-buildx
  - btrfs-progs
  # The specs read LinuxIO's job records with it; Ubuntu's image has it and
  # Debian's does not.
  - jq
  # What the DEB depends on besides systemd, so installing it in the VM needs
  # no download (packaging/debian/control).
  - libnss-systemd
  - libpam0g
  - packagekit
  - polkitd
  # What assembles LinuxIO's DEB in the VM (linuxio-vm.sh install), and what
  # publishes it into a signed repository (linuxio-vm.sh repo-publish).
  - debhelper
  - apt-utils
  - gnupg
runcmd:
  # Unattended apt runs stall the reboot and power-cut checks.
  - systemctl disable --now apt-daily.timer apt-daily-upgrade.timer
