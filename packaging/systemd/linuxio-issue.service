[Unit]
Description=LinuxIO login banner
Documentation=https://github.com/mordilloSan/LinuxIO
PartOf=linuxio.target
Wants=network-online.target
After=network-online.target linuxio-webserver.socket

[Service]
Type=oneshot
RemainAfterExit=yes
# The addresses LinuxIO answers on, and how to start it once it stopped, in
# /run/linuxio/issue, which /etc/motd.d/linuxio and /etc/issue.d/linuxio.issue
# link to.
ExecStart=-/usr/share/linuxio/issue/update-issue
ExecStop=-/usr/share/linuxio/issue/update-issue stop
