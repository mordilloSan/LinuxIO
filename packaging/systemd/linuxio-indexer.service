[Unit]
Description=LinuxIO Filesystem Indexer
Documentation=https://github.com/mordilloSan/LinuxIO
PartOf=linuxio.target
Requires=linuxio-webserver.socket
After=linuxio-webserver.socket linuxio-indexer.socket linuxio-indexer-tcp.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/linuxio-indexer --config-file /etc/linuxio/indexer/config.yaml
Restart=on-failure
RestartSec=5s
StateDirectory=linuxio/indexer
StateDirectoryMode=0750

# The scanner needs read access to the host filesystem, but writes only its
# canonical config and index state.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# SQLite may spill larger operations to temporary files.
PrivateTmp=true
ReadWritePaths=/etc/linuxio/indexer /var/lib/linuxio/indexer
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0027

[Install]
WantedBy=linuxio.target
