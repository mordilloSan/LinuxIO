[Unit]
Description=Rebuild LinuxIO btrfs pool %i onto a disk that came back or its hot spare
Documentation=https://github.com/mordilloSan/LinuxIO

[Service]
Type=oneshot
ExecStartPre=-+/usr/local/bin/linuxio-worker scheduled-run begin --unit %n
ExecStart=/usr/local/bin/linuxio-worker rebuild %i
ExecStopPost=-+/usr/local/bin/linuxio-worker scheduled-run end --unit %n
