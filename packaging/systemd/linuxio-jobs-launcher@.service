[Unit]
Description=LinuxIO Job Host Launcher %I
Documentation=https://github.com/mordilloSan/LinuxIO
Requires=linuxio-jobs-launcher.socket
After=linuxio-jobs-launcher.socket

[Service]
ExecStart=/usr/local/bin/linuxio-bridge jobs launch
StandardInput=socket
# stdin is the client connection; output on it would corrupt the reply.
StandardOutput=journal
StandardError=journal
User=root
Group=root
RuntimeMaxSec=15s
NoNewPrivileges=yes
