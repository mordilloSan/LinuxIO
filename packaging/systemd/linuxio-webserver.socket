[Unit]
Description=LinuxIO Web Server (TCP socket)
Documentation=https://github.com/mordilloSan/LinuxIO
PartOf=linuxio.target
Wants=linuxio-issue.service linuxio-indexer.socket
# A restart of linuxio.target stops this socket and starts it again. Without
# this ordering systemd also starts linuxio-auth.socket in that window; it
# forks an sd-chown helper that inherits the old listening fd and keeps :8090
# bound for a few ms after systemd closed it, so the new bind fails with
# "Address already in use". Ordered after the auth socket, this one is stopped
# first and started last, with no helper holding its fd.
After=linuxio-auth.socket

[Socket]
# Port-only form binds dual-stack (IPv4 + IPv6 via IPV6_V6ONLY=0).
# Needed so that hostname.local clients reaching us over the AAAA
# record Avahi publishes also connect, not just the A record.
ListenStream=8090
BindIPv6Only=both

# Tuning
Backlog=4096
NoDelay=true
ReusePort=false

RemoveOnStop=true

[Install]
WantedBy=linuxio.target
