[Unit]
Description=Reconcile LinuxIO jobs interrupted by a reboot
Documentation=https://github.com/mordilloSan/LinuxIO
# Pools must be mounted before their interrupted jobs are resumed.
After=local-fs.target linuxio-btrfs-degraded.service

[Service]
# READY=1 once every store is marked: job hosts are ordered after this unit,
# and the resumes that follow need the root host running.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/linuxio-bridge jobs reconcile
# Once per boot: a second run would mark jobs started since then interrupted.
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
