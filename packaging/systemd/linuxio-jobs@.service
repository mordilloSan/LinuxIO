[Unit]
Description=LinuxIO jobs for uid %i
Documentation=https://github.com/mordilloSan/LinuxIO
# A connection to the socket starts the host. Pools must be mounted before the
# root host resumes the jobs a reboot interrupted.
Wants=linuxio-jobs@%i.socket
After=linuxio-jobs@%i.socket local-fs.target linuxio-btrfs-degraded.service
# Deliberately not PartOf=linuxio.target: updates must not stop running jobs.

[Service]
Type=notify
NotifyAccess=main
User=%i
# No arguments: the bridge knows it is the job host from the socket systemd
# passes it.
ExecStart=/usr/local/bin/linuxio-bridge
StateDirectory=linuxio/jobs/%i
StateDirectoryMode=0700
RuntimeDirectory=linuxio/jobs/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStopSec=2min
KillMode=mixed
NoNewPrivileges=yes
# A runaway job hits these instead of the machine. TasksMax leaves room for
# 256 jobs each waiting on a subprocess tree: below that, the Go runtime
# cannot create a thread and aborts the host with every job in it.
# OOMPolicy=continue: one job's subprocess killed for memory must not
# interrupt the others.
TasksMax=8192
MemoryMax=2G
OOMPolicy=continue

[Install]
# Enabled for uid 0, so the root host starts at boot to mark, alert and resume
# the jobs a reboot interrupted.
WantedBy=multi-user.target
