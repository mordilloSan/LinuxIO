[Unit]
Description=LinuxIO Authentication Worker %I
Documentation=https://github.com/mordilloSan/LinuxIO
PartOf=linuxio.target
Requires=linuxio-auth.socket
After=linuxio-auth.socket

[Service]
ExecStart=/usr/local/bin/linuxio-auth
StandardInput=socket
StandardOutput=inherit
StandardError=journal
User=root
Group=root
SuccessExitStatus=1 5 126 127
Restart=no

# Limits the bridge inherits. Keep UID-scoped process and virtual
# address-space rlimits out of the way.
LimitNOFILE=2048
LimitNPROC=infinity
LimitAS=infinity
LimitCORE=0
# No TasksMax or MemoryMax: a login is not capped. pam_systemd moves it into a
# logind session scope, as it does an SSH login, where limits set here would
# not apply; and it holds the web terminal and the assistant's agents, whose
# work is the user's to size. Jobs are bounded by linuxio-jobs@.service.
