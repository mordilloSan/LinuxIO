[Unit]
Description=LinuxIO Job Host Launcher Socket
Documentation=https://github.com/mordilloSan/LinuxIO

[Socket]
ListenStream=/run/linuxio/jobs-launcher.sock
SocketUser=root
SocketGroup=root
# Any user may connect: the launcher only ever starts the caller's own host.
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes
Accept=yes
MaxConnections=64
MaxConnectionsPerSource=8

[Install]
WantedBy=multi-user.target
