[Unit]
Description=Resync LinuxIO btrfs pool %i after its missing disk returned
Documentation=https://github.com/mordilloSan/LinuxIO

[Service]
Type=oneshot
ExecStartPre=-+/usr/libexec/linuxio/linuxio-worker scheduled-run begin --unit %n
ExecStart=/usr/libexec/linuxio/linuxio-worker resync %i
ExecStopPost=-+/usr/libexec/linuxio/linuxio-worker scheduled-run end --unit %n
