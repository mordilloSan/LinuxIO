[Unit]
Description=Resync LinuxIO btrfs pool %i after its missing disk returned
Documentation=https://github.com/mordilloSan/LinuxIO

[Service]
Type=oneshot
ExecStartPre=-+/usr/local/bin/linuxio scheduled-run begin --unit %n
ExecStart=/usr/local/bin/linuxio-btrfs-timer resync %i
ExecStopPost=-+/usr/local/bin/linuxio scheduled-run end --unit %n
