[Unit]
Description=Run the LinuxIO filesystem index
Documentation=https://github.com/mordilloSan/LinuxIO
PartOf=linuxio.target
Requisite=linuxio-indexer.socket
After=linuxio-indexer.socket

[Service]
Type=oneshot
# The scanner. It asks the indexer daemon for its turn over the socket, which
# starts the daemon when it is not running, and scans when no other index
# work runs.
ExecStart=/usr/libexec/linuxio/linuxio-indexer --index-mode --config /etc/linuxio/indexer/config.yaml
# It yields the CPU to everything else on the host, the daemon's searches
# included, and reads the disk only when nothing else wants it, on a disk
# whose scheduler honours the class (BFQ, mq-deadline). The database pages it
# writes are flushed later by the kernel and do not carry the class.
Nice=19
IOSchedulingClass=idle
# A scan that stops moving ends itself after half an hour
# (backend/indexer/internal/daemon/stall.go), however long it has run. This
# is the limit for a scan that keeps moving and is too slow to be of use, and
# the backstop for a scanner that cannot end itself: a oneshot has no start
# timeout of its own, the index's other work waits while a scan runs, and
# while this unit is active the timer starts no other scan. A day is the
# default interval of the timer: a scan still running when the next is due
# is given up on.
TimeoutStartSec=24h
Environment=SQLITE_TMPDIR=/var/lib/linuxio/indexer

# It reads the host's files and writes only the index.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/linuxio/indexer
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0027
